// Domma Mart — modelo de dados (Descritivo Técnico v2.0, seções 7 e 21)
// Convenções: ids UUID v7 (função SQL uuid_generate_v7), valores em centavos (BigInt),
// campos sensíveis cifrados com sufixo _enc e, quando buscáveis, _hash (HMAC-SHA256).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Contas, papéis e KYC ─────────────────────────

enum UserStatus {
  active
  blocked
}

enum PlatformRole {
  none
  support
  compliance
  finance
  super_admin
}

model users {
  id                String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email             String       @unique @db.Citext
  name              String
  phone_enc         Bytes?
  password_hash     String?
  google_sub        String?      @unique
  email_verified_at DateTime?    @db.Timestamptz
  totp_secret_enc   Bytes?
  totp_enabled_at   DateTime?    @db.Timestamptz
  otp_failed        Int          @default(0)
  otp_locked_until  DateTime?    @db.Timestamptz
  failed_logins     Int          @default(0)
  locked_until      DateTime?    @db.Timestamptz
  platform_role     PlatformRole @default(none)
  status            UserStatus   @default(active)
  created_at        DateTime     @default(now()) @db.Timestamptz
  updated_at        DateTime     @updatedAt @db.Timestamptz

  memberships memberships[]
  sessions    sessions[]
}

model sessions {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id      String   @db.Uuid
  token_hash   String   @unique
  kind         String   @default("producer") // producer | admin
  user_agent   String?
  ip_hash      String?
  expires_at   DateTime @db.Timestamptz
  last_seen_at DateTime @default(now()) @db.Timestamptz
  revoked_at   DateTime? @db.Timestamptz
  created_at   DateTime @default(now()) @db.Timestamptz
  user         users    @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model email_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id    String    @db.Uuid
  purpose    String // verify_email | reset_password
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz
  used_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
}

enum KycStatus {
  pending
  in_review
  approved
  rejected
  blocked
}

enum PersonType {
  pf
  pj
}

model workspaces {
  id                       String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  owner_id                 String      @db.Uuid
  name                     String
  person_type              PersonType?
  document_enc             Bytes?
  document_hash            String?
  kyc_status               KycStatus   @default(pending)
  gateway_subaccount_id    String?
  custom_fee_bps           Int? // taxa negociada (RN-05), em pontos-base
  daily_withdraw_limit     BigInt      @default(5000000)
  reserve_pct              Int         @default(0) // reserva de segurança (rolling reserve)
  blocked_at               DateTime?   @db.Timestamptz
  blocked_reason           String?
  support_whatsapp         String?
  support_email            String?
  created_at               DateTime    @default(now()) @db.Timestamptz
  updated_at               DateTime    @updatedAt @db.Timestamptz

  memberships memberships[]
  products    products[]
}

model memberships {
  id           String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id      String     @db.Uuid
  workspace_id String     @db.Uuid
  role         String // owner | collaborator
  permissions  String[]
  created_at   DateTime   @default(now()) @db.Timestamptz
  updated_at   DateTime   @updatedAt @db.Timestamptz
  user         users      @relation(fields: [user_id], references: [id])
  workspace    workspaces @relation(fields: [workspace_id], references: [id])

  @@unique([user_id, workspace_id])
}

model kyc_submissions {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id    String    @db.Uuid
  person_type     PersonType
  name            String
  document_enc    Bytes
  document_last4  String
  birth_date      String?
  partner_name    String?
  doc_front_key   String?
  doc_back_key    String?
  selfie_key      String?
  auto_checks     Json
  risk            String    @default("low") // low | medium | high
  status          KycStatus @default(in_review)
  decided_by      String?   @db.Uuid
  decision_reason String?
  decided_at      DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  @@index([status, created_at])
}

model legal_acceptances {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id    String   @db.Uuid
  document   String // terms | privacy | prohibited_products
  version    String
  ip_hash    String?
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz
}

model payout_accounts {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id  String    @unique @db.Uuid
  pix_key_enc   Bytes
  pix_key_mask  String
  holder_name   String
  holder_doc_hash String
  active_from   DateTime  @db.Timestamptz // carência de 24 h (RN-37)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
}

// ───────────────────────── Produtos e ofertas ─────────────────────────

enum ProductType {
  course
  file
  service
  subscription
}

enum ModerationStatus {
  draft
  approved
  in_review
  rejected
}

model products {
  id                String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id      String           @db.Uuid
  type              ProductType
  name              String
  description       String?
  cover_url         String?
  service_url       String? // link de agendamento (mentoria)
  moderation_status ModerationStatus @default(draft)
  moderation_notes  String?
  guarantee_days    Int              @default(7)
  affiliation_enabled Boolean        @default(false)
  affiliation_auto_approve Boolean   @default(true)
  affiliate_commission_bps Int       @default(3000)
  affiliate_cookie_days Int          @default(60)
  affiliate_attribution String       @default("last_click")
  published_at      DateTime?        @db.Timestamptz
  deleted_at        DateTime?        @db.Timestamptz
  created_at        DateTime         @default(now()) @db.Timestamptz
  updated_at        DateTime         @updatedAt @db.Timestamptz

  workspace workspaces @relation(fields: [workspace_id], references: [id])
  offers    offers[]
  modules   course_modules[]
  files     product_files[]

  @@index([workspace_id])
}

enum BillingType {
  one_time
  subscription
}

enum BillingInterval {
  month
  quarter
  semester
  year
}

enum InterestMode {
  buyer
  producer
}

enum OfferStatus {
  draft
  active
  paused
  ended
}

model offers {
  id                   String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id         String           @db.Uuid
  product_id           String           @db.Uuid
  slug                 String           @unique
  name                 String           @default("Padrão")
  price_cents          BigInt
  billing_type         BillingType      @default(one_time)
  interval             BillingInterval?
  trial_days           Int              @default(0)
  max_installments     Int              @default(12)
  installment_interest InterestMode     @default(buyer)
  methods              String[]         @default(["pix", "card"])
  guarantee_days       Int              @default(7)
  sales_limit          Int?
  ends_at              DateTime?        @db.Timestamptz
  pix_expiration_min   Int              @default(30)
  boleto_due_days      Int              @default(3)
  thank_you_url        String?
  theme                Json?
  status               OfferStatus      @default(draft)
  created_at           DateTime         @default(now()) @db.Timestamptz
  updated_at           DateTime         @updatedAt @db.Timestamptz

  product products      @relation(fields: [product_id], references: [id])
  bumps   offer_bumps[] @relation("main")
}

model offer_bumps {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  offer_id      String   @db.Uuid
  bump_offer_id String   @db.Uuid
  headline      String?
  position      Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz
  offer         offers   @relation("main", fields: [offer_id], references: [id])

  @@unique([offer_id, bump_offer_id])
}

model coupons {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id  String    @db.Uuid
  code          String
  kind          String // percent | fixed
  value         Int // bps para percent, centavos para fixed
  offer_ids     String[]  @db.Uuid
  affiliate_workspace_id String? @db.Uuid
  starts_at     DateTime? @db.Timestamptz
  ends_at       DateTime? @db.Timestamptz
  max_uses      Int?
  max_uses_per_cpf Int?
  uses          Int       @default(0)
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz

  @@unique([workspace_id, code])
}

model coproductions {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  product_id      String    @db.Uuid
  workspace_id    String    @db.Uuid // workspace do sócio
  invited_email   String    @db.Citext
  share_bps       Int // % sobre o líquido do produtor
  status          String    @default("invited") // invited | active | ended
  ends_at         DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
}

// ───────────────────────── Área de membros ─────────────────────────

model course_modules {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  product_id String   @db.Uuid
  title      String
  position   Int
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  product    products @relation(fields: [product_id], references: [id])
  lessons    lessons[]
}

model lessons {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  module_id     String   @db.Uuid
  product_id    String   @db.Uuid
  title         String
  kind          String   @default("video") // video | text | pdf | link
  body          String?
  storage_key   String?
  status        String   @default("ready") // processing | ready | error
  duration_sec  Int?
  drip_days     Int?
  drip_date     DateTime? @db.Timestamptz
  required      Boolean  @default(true)
  position      Int
  attachments   Json     @default("[]")
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz
  module        course_modules @relation(fields: [module_id], references: [id])
}

model product_files {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  product_id  String   @db.Uuid
  filename    String
  storage_key String
  mime        String
  size        BigInt
  created_at  DateTime @default(now()) @db.Timestamptz
  product     products @relation(fields: [product_id], references: [id])
}

model uploads {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id String   @db.Uuid
  product_id   String   @db.Uuid
  filename     String
  mime         String
  size         BigInt
  storage_key  String
  received     BigInt   @default(0)
  status       String   @default("uploading") // uploading | processing | ready | error
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
}

model lesson_progress {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customer_id  String    @db.Uuid
  lesson_id    String    @db.Uuid
  product_id   String    @db.Uuid
  position_sec Int       @default(0)
  completed_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz

  @@unique([customer_id, lesson_id])
}

model certificates {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code        String   @unique
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  student_name String
  course_name String
  issued_at   DateTime @default(now()) @db.Timestamptz

  @@unique([customer_id, product_id])
}

model playback_sessions {
  id                  String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customer_id         String   @db.Uuid
  product_id          String   @db.Uuid
  customer_session_id String   @db.Uuid
  last_seen_at        DateTime @default(now()) @db.Timestamptz
  ended_at            DateTime? @db.Timestamptz

  @@unique([customer_session_id, product_id])
  @@index([customer_id, product_id])
}

// ───────────────────────── Compradores e pedidos ─────────────────────────

model customers {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email             String   @unique @db.Citext
  name              String
  document_enc      Bytes
  document_hash     String
  phone_enc         Bytes
  phone_hash        String
  marketing_consent Json?
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  @@index([document_hash])
  @@index([phone_hash])
}

model customer_auth_tokens {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customer_id String?   @db.Uuid
  kind        String // magic | otp | order
  token_hash  String    @unique
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamptz
  used_at     DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz
}

model customer_sessions {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  customer_id  String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime  @db.Timestamptz
  revoked_at   DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
}

model checkout_leads {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id   String    @db.Uuid
  offer_id       String    @db.Uuid
  email          String    @db.Citext
  name           String?
  phone_enc      Bytes?
  converted_at   DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz

  @@unique([offer_id, email])
}

model checkout_views {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id String   @db.Uuid
  offer_id     String   @db.Uuid
  tracking     Json?
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([workspace_id, created_at])
}

enum OrderStatus {
  created
  pending
  paid
  refund_requested
  refunded
  chargeback
  chargeback_won
  chargeback_lost
  expired
  failed
  abandoned
}

enum PaymentMethod {
  pix
  card
  boleto
}

model orders {
  id                String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code              String        @unique
  workspace_id      String        @db.Uuid
  customer_id       String        @db.Uuid
  offer_id          String        @db.Uuid
  status            OrderStatus   @default(created)
  method            PaymentMethod
  installments      Int           @default(1)
  subtotal_cents    BigInt
  discount_cents    BigInt        @default(0)
  interest_cents    BigInt        @default(0)
  total_cents       BigInt
  coupon_id         String?       @db.Uuid
  affiliate_workspace_id String?  @db.Uuid
  subscription_id   String?       @db.Uuid
  tracking          Json?
  ip_hash           String
  user_agent        String
  device_fingerprint String?
  idempotency_key   String        @unique
  purchase_event_sent_at DateTime? @db.Timestamptz
  paid_at           DateTime?     @db.Timestamptz
  refunded_at       DateTime?     @db.Timestamptz
  guarantee_ends_at DateTime?     @db.Timestamptz
  created_at        DateTime      @default(now()) @db.Timestamptz
  updated_at        DateTime      @updatedAt @db.Timestamptz

  items    order_items[]
  payments payments[]
  splits   splits[]
  events   order_events[]

  @@index([workspace_id, created_at])
  @@index([customer_id])
}

model order_items {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  order_id   String   @db.Uuid
  product_id String   @db.Uuid
  offer_id   String   @db.Uuid
  kind       String // main | bump
  price_cents BigInt
  status     String   @default("active") // active | refunded
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  order      orders   @relation(fields: [order_id], references: [id])
}

model order_events {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  order_id   String   @db.Uuid
  from_status OrderStatus?
  to_status  OrderStatus
  event      String
  data       Json?
  created_at DateTime @default(now()) @db.Timestamptz
  order      orders   @relation(fields: [order_id], references: [id])

  @@index([order_id, created_at])
}

model payments {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  order_id           String    @db.Uuid
  provider           String
  provider_charge_id String    @unique
  method             PaymentMethod
  status             String // pending | authorized | paid | declined | refunded | expired
  raw_status         String
  decline_code       String?
  card_brand         String?
  card_last4         String?
  card_token_ref     String?
  pix_qr             String?
  pix_copy_paste     String?
  pix_expires_at     DateTime? @db.Timestamptz
  boleto_url         String?
  boleto_line        String?
  boleto_due_at      DateTime? @db.Timestamptz
  risk_score         Int?
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  order              orders    @relation(fields: [order_id], references: [id])
}

model splits {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  order_id         String   @db.Uuid
  beneficiary_type String // platform | affiliate | coproducer | producer
  beneficiary_id   String?  @db.Uuid
  amount_cents     BigInt
  rule             Json
  created_at       DateTime @default(now()) @db.Timestamptz
  order            orders   @relation(fields: [order_id], references: [id])
}

model refunds {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  order_id     String   @db.Uuid
  requested_by String // customer | producer | platform
  reason       String?
  amount_cents BigInt
  status       String   @default("processing") // processing | done | failed
  provider_refund_id String?
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
}

model subscriptions {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id             String    @db.Uuid
  customer_id              String    @db.Uuid
  offer_id                 String    @db.Uuid
  status                   String // trialing | active | past_due | canceled | defaulted
  price_cents              BigInt
  card_token_ref           String?
  card_brand               String?
  card_last4               String?
  current_period_end       DateTime  @db.Timestamptz
  next_charge_at           DateTime? @db.Timestamptz
  retry_count              Int       @default(0)
  cancel_at_period_end     Boolean   @default(false)
  provider_subscription_id String?
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @updatedAt @db.Timestamptz
}

model enrollments {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id  String    @db.Uuid
  customer_id   String    @db.Uuid
  product_id    String    @db.Uuid
  order_item_id String    @unique @db.Uuid
  status        String    @default("active") // active | suspended | revoked | expired
  expires_at    DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz

  @@index([customer_id, product_id])
}

// ───────────────────────── Financeiro (ledger) ─────────────────────────

// Somente INSERT. Trigger no banco bloqueia UPDATE/DELETE (prisma/sql/001_functions.sql).
// owner_type+owner_id+bucket = conta contábil. Buckets: balance (sacável quando
// available_at <= agora; antes disso é "Chegando"), blocked (Em análise), clearing (contrapartida).
model ledger_entries {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  transaction_id String   @db.Uuid
  owner_type     String // workspace | platform | gateway
  owner_id       String?  @db.Uuid
  bucket         String // balance | blocked | clearing
  debit_cents    BigInt   @default(0)
  credit_cents   BigInt   @default(0)
  reference_type String // order | refund | withdrawal | chargeback | adjustment
  reference_id   String   @db.Uuid
  available_at   DateTime @db.Timestamptz
  description    String
  created_by     String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([owner_type, owner_id, bucket, available_at])
  @@index([transaction_id])
  @@index([reference_type, reference_id])
}

model withdrawals {
  id                   String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id         String    @db.Uuid
  amount_cents         BigInt
  destination_enc      Bytes
  destination_mask     String
  status               String    @default("requested") // requested | processing | paid | failed
  otp_verified_at      DateTime  @db.Timestamptz
  provider_transfer_id String?
  failure_reason       String?
  idempotency_key      String    @unique
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  @@index([workspace_id, created_at])
}

// ───────────────────────── Afiliados ─────────────────────────

model affiliations {
  id                     String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  product_id             String   @db.Uuid
  producer_workspace_id  String   @db.Uuid
  affiliate_workspace_id String   @db.Uuid
  affiliate_user_id      String   @db.Uuid
  code                   String   @unique
  status                 String   @default("pending") // pending | active | blocked
  created_at             DateTime @default(now()) @db.Timestamptz
  updated_at             DateTime @updatedAt @db.Timestamptz

  @@unique([product_id, affiliate_workspace_id])
}

model affiliate_clicks {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  affiliation_id String   @db.Uuid
  ip_hash        String
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([affiliation_id, created_at])
}

model affiliate_bindings {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  product_id     String   @db.Uuid
  customer_key   String // hash de CPF ou e-mail do comprador (RN-70)
  affiliation_id String   @db.Uuid
  expires_at     DateTime @db.Timestamptz
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  @@unique([product_id, customer_key])
}

// ───────────────────────── Integrações, notificações, auditoria ─────────────────────────

model webhook_events_in {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider     String
  event_id     String
  type         String
  payload      Json
  processed_at DateTime? @db.Timestamptz
  error        String?
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@unique([provider, event_id])
}

model webhook_endpoints {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id String    @db.Uuid
  url          String
  secret_enc   Bytes
  events       String[]
  active       Boolean   @default(true)
  disabled_at  DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
}

model webhook_deliveries {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  endpoint_id   String    @db.Uuid
  event_id      String
  event_type    String
  payload       Json
  attempts      Int       @default(0)
  last_status   Int?
  last_error    String?
  delivered_at  DateTime? @db.Timestamptz
  next_attempt_at DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
}

model notifications {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id String?   @db.Uuid
  channel      String // email | whatsapp | push
  to_masked    String
  template     String
  subject      String?
  body         String
  status       String    @default("queued") // queued | sent | failed | skipped
  ref_type     String?
  ref_id       String?
  error        String?
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz

  @@index([ref_type, ref_id])
}

model recovery_settings {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspace_id String   @unique @db.Uuid
  pix_unpaid   Boolean  @default(true)
  boleto_unpaid Boolean @default(true)
  card_declined Boolean @default(true)
  abandoned    Boolean  @default(true)
  email        Boolean  @default(true)
  whatsapp     Boolean  @default(true)
  delays_min   Int[]    @default([15, 120, 1440])
  template     String   @default("{nome}, seu pedido de {produto} ainda está esperando. Termine aqui: {link}")
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
}

model opt_outs {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key_hash   String   @unique // hash de e-mail/telefone
  created_at DateTime @default(now()) @db.Timestamptz
}

model idempotency_keys {
  key           String   @id
  scope         String
  request_hash  String
  response      Json?
  status_code   Int?
  created_at    DateTime @default(now()) @db.Timestamptz
}

model blocklist {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind       String // cpf | email | email_domain | card | ip | bin
  value_hash String
  reason     String
  expires_at DateTime? @db.Timestamptz
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  @@unique([kind, value_hash])
}

model risk_events {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind       String // card_decline | card_testing | velocity
  key        String
  offer_id   String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([kind, key, created_at])
}

model audit_logs {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  seq        BigInt   @default(autoincrement())
  actor_id   String?  @db.Uuid
  action     String
  target     String
  before     Json?
  after      Json?
  ip_hash    String?
  reason     String?
  prev_hash  String
  hash       String
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([target])
}

model fee_tiers_cache {
  workspace_id    String   @id @db.Uuid
  revenue_30d     BigInt
  fee_bps         Int
  computed_at     DateTime @db.Timestamptz
}
